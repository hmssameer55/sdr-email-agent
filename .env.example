# Model: any OpenAI-compatible endpoint. Groq has a free tier.
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=your-groq-key
MODEL_NAME=openai/gpt-oss-120b

# Optional: only used to upload traces to platform.openai.com/traces
OPENAI_API_KEY=

# SMTP (Gmail: smtp.gmail.com + an App Password, not your normal password)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_ADDRESS=you@example.com
EMAIL_APP_PASSWORD=your-app-password
# Optional: who receives the email (defaults to EMAIL_ADDRESS)
EMAIL_TO=
